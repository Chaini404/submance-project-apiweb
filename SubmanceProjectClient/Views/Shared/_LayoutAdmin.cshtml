<!-- Shared/_LayoutAdmin.cshtml -->
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    // Recuperamos datos de sesión
    var userRole = HttpContextAccessor.HttpContext.Session.GetString("UserRole") ?? "Invitado";
    var userEmail = HttpContextAccessor.HttpContext.Session.GetString("UserEmail") ?? "";
    var userName = userEmail.Split('@')[0]; // Nombre corto para mostrar

    // Lógica para que el logo lleve al "Home" correcto del usuario
    string dashboardUrl = Url.Action("Index", "Home");
    if (userRole == "Admin") dashboardUrl = Url.Action("Dashboard", "Admin");
    if (userRole == "Staff") dashboardUrl = Url.Action("Index", "Staff");
    if (userRole == "Artista") dashboardUrl = Url.Action("Index", "ArtistPortal");

    // Helpers para saber qué menú está activo (para pintarlo de blanco)
    string currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    string currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}

<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Submance Internal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <nav class="sidebar d-flex flex-column flex-shrink-0 p-3 text-white bg-dark" style="width: 280px; height: 100vh; position: fixed;">

        <a href="@dashboardUrl" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
            <i class="bi bi-soundwave fs-4 me-2"></i>
            <span class="fs-4 fw-bold">Submance</span>
            <span class="badge bg-primary ms-2" style="font-size: 0.6rem; vertical-align: top;">@userRole</span>
        </a>

        <hr>

        <ul class="nav nav-pills flex-column mb-auto">

            <li class="nav-item mb-2">
                <a href="@Url.Action("Index", "Home")" class="nav-link text-white-50">
                    <i class="bi bi-box-arrow-up-right me-2"></i> Web Pública
                </a>
            </li>

            @if (userRole == "Admin")
            {
                <li class="nav-item mt-3 text-uppercase text-secondary small fw-bold px-3">Gerencia</li>

                <li class="nav-item">
                    <a href="@Url.Action("Dashboard", "Admin")" class="nav-link text-white @(currentAction == "Dashboard" && currentController == "Admin" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Artista")" class="nav-link text-white @(currentController == "Artista" ? "active" : "")">
                        <i class="bi bi-mic me-2"></i> Artistas
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Usuario")" class="nav-link text-white @(currentController == "Usuario" ? "active" : "")">
                        <i class="bi bi-people me-2"></i> Usuarios
                    </a>
                </li>
            }

            @if (userRole == "Staff" || userRole == "Admin")
            {
                <li class="nav-item mt-3 text-uppercase text-secondary small fw-bold px-3">A&R Dept</li>
                <li>
                    <a href="@Url.Action("Index", "Staff")" class="nav-link text-white @(currentController == "Staff" ? "active" : "")">
                        <i class="bi bi-music-note-list me-2"></i> Revisión Demos
                    </a>
                </li>
            }

            @if (userRole == "Artista")
            {
                <li class="nav-item mt-3 text-uppercase text-secondary small fw-bold px-3">Artist Zone</li>
                <li>
                    <a href="@Url.Action("Index", "ArtistPortal")" class="nav-link text-white @(currentController == "ArtistPortal" ? "active" : "")">
                        <i class="bi bi-vinyl me-2"></i> Mis Tracks
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Create", "Demo")" class="nav-link text-white @(currentController == "Demo" ? "active" : "")">
                        <i class="bi bi-cloud-upload me-2"></i> Subir Demo
                    </a>
                </li>
            }
        </ul>

        <hr>

        <div class="dropdown">
            <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="rounded-circle bg-secondary d-flex justify-content-center align-items-center me-2" style="width: 32px; height: 32px;">
                    @userName.Substring(0, 1).ToUpper()
                </div>
                <strong>@userName</strong>
            </a>
            <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="dropdownUser1">
                <li><a class="dropdown-item" href="#">Perfil</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="@Url.Action("Logout", "Admin")">Cerrar Sesión</a></li>
            </ul>
        </div>
    </nav>

    <main class="d-flex flex-column" style="margin-left: 280px; min-height: 100vh; background-color: #0f0f0f;">
        <div class="p-4">
            @RenderBody()
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>