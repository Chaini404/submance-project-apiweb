@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    // Recuperamos datos de sesión para personalizar la barra
    var userRole = HttpContextAccessor.HttpContext.Session.GetString("UserRole") ?? "Invitado";
    var userEmail = HttpContextAccessor.HttpContext.Session.GetString("UserEmail") ?? "";
    var userName = userEmail.Split('@')[0]; // Usamos la parte antes del @ como nombre corto
}

<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Submance Music</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <nav class="sidebar">
        <div class="brand-logo">
            <i class="bi bi-soundwave me-2"></i> Submance
        </div>

        <ul class="nav-links">
            <li class="nav-item">
                <a href="@Url.Action("Index", "Home")">
                    <i class="bi bi-globe"></i> Web Pública
                </a>
            </li>

            @if (userRole == "Admin")
            {
                <li class="nav-item">
                    <span class="d-block text-muted small text-uppercase px-4 mt-3 mb-2">Administración</span>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Artista")" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Artista" ? "active" : "")">
                        <i class="bi bi-people"></i> Artistas
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Usuario")">
                        <i class="bi bi-shield-lock"></i> Usuarios
                    </a>
                </li>
            }

            @if (userRole == "Staff" || userRole == "Admin")
            {
                <li class="nav-item">
                    <span class="d-block text-muted small text-uppercase px-4 mt-3 mb-2">A&R / Demos</span>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Staff")" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "Staff" ? "active" : "")">
                        <i class="bi bi-music-note-list"></i> Inbox Demos
                    </a>
                </li>
            }

            @if (userRole == "Artista")
            {
                <li class="nav-item">
                    <span class="d-block text-muted small text-uppercase px-4 mt-3 mb-2">Artist Zone</span>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "ArtistPortal")" class="@(ViewContext.RouteData.Values["Controller"].ToString() == "ArtistPortal" ? "active" : "")">
                        <i class="bi bi-vinyl"></i> Mis Tracks
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Create", "Demo")">
                        <i class="bi bi-cloud-upload"></i> Subir Demo
                    </a>
                </li>
            }
        </ul>

        <div class="user-profile">
            <div class="d-flex align-items-center mb-2">
                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center text-white me-2" style="width: 32px; height: 32px;">
                    @userName.Substring(0, 1).ToUpper()
                </div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-white small text-truncate">@userName</div>
                    <div class="text-muted small" style="font-size: 0.75rem;">@userRole</div>
                </div>
            </div>
            <a href="@Url.Action("Logout", "Admin")" class="btn btn-sm btn-outline-light w-100">
                <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
            </a>
        </div>
    </nav>

    <main class="main-content">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>