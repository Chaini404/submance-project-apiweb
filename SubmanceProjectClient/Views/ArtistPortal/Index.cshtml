<!-- ArtistPortal/Index.cshtml -->
@model IEnumerable<Submance.Domain.Entities.Cancion>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal de Artista - @ViewBag.ArtistName</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;700&family=Oswald:wght@500;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/artist-portal.css" />
</head>
<body>

    <div class="container-fluid px-md-5">
        <header class="portal-header d-flex justify-content-between align-items-end flex-wrap gap-3">
            <div>
                <span class="brand-text">Submance Records // Artist Portal</span>
                <h1 class="portal-title">MIS DEMOS</h1>
            </div>
            <div class="d-flex gap-3 align-items-center">
                <button class="btn-submance" data-bs-toggle="modal" data-bs-target="#modalUpload">
                    <i class="bi bi-cloud-arrow-up-fill me-2"></i>Enviar Nuevo
                </button>
                <a href="/Admin/Logout" class="btn-logout text-decoration-none">
                    <i class="bi bi-box-arrow-right fs-5"></i>
                </a>
            </div>
        </header>

        <div class="table-container">
            <table class="industrial-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>TRACK / INFORMACIÓN</th>
                        <th>ESTADO A&R</th>
                        <th>FECHA DE ENVÍO</th>
                        <th class="text-end">PREVIEW</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted small">#@item.IdDemo</td>
                            <td>
                                <div class="track-title">@item.Titulo</div>
                                <span class="text-muted small">Original Mix</span>
                            </td>
                            <td>
                                <span class="status-pill pill-@item.Estado">@item.Estado</span>
                            </td>
                            <td class="text-muted">@item.FechaEnvio.ToString("dd MMM, yyyy")</td>
                            <td class="text-end">
                                <button class="play-btn" onclick="playTrack('@item.UrlAudio', '@item.Titulo')">
                                    <i class="bi bi-play-fill fs-5"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade" id="modalUpload" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-uppercase">Subir Demo</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="formUpload">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">

                        <div class="mb-3">
                            <label class="small text-muted mb-2 text-uppercase">Título</label>
                            <input type="text" name="Titulo" class="form-control"
                                   placeholder="Ej: Stellar Drift" required>
                        </div>

                        <div class="mb-4">
                            <label class="small text-muted mb-2 text-uppercase">URL Audio</label>
                            <input type="text" name="UrlAudio" class="form-control"
                                   placeholder="https://ejemplo.com/archivo.mp3 o link de SoundCloud" required>

                            <div id="url-hint" class="small mt-1"></div>

                            <button type="button" id="btn-preview-upload"
                                    class="btn btn-outline-info btn-sm mt-2"
                                    style="display:none;">
                                <i class="bi bi-play-circle me-1"></i> Previsualizar audio
                            </button>
                        </div>

                        <input type="hidden" name="IdArtista" value="@ViewBag.ArtistId" />
                        <input type="hidden" name="IdGenero" value="1" />

                        <button type="button" onclick="save()" class="btn-submance w-100">
                            Enviar a A&amp;R
                        </button>

                    </div>
                </form>
            </div>
        </div>
    </div>

    <div id="player-bar" class="player-bar" style="display:none;">
        <audio id="audio-main" controls class="d-none"></audio>
        <div class="d-flex justify-content-between align-items-center px-4 py-2">
            <div>
                <div id="p-title" class="player-title">--</div>
                <small class="text-muted">Preview</small>
            </div>
            <button class="btn btn-outline-light btn-sm" onclick="closePlayer()">CERRAR</button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>window.artistId = @ViewBag.ArtistId;</script>
    <script src="~/js/artist-portal.js"></script>
</body>
</html>