@using Submance.Application.DTOs.Usuario
@model LoginRequestDto
@{
    Layout = null;
    ViewData["Title"] = "Staff Access";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staff Access - Submance</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/submance-vibe.css" asp-append-version="true" />
</head>
<body style="background-color: #f9f9f9; display: flex; align-items: center; justify-content: center; height: 100vh;">

    <div style="width: 100%; max-width: 400px; text-align: center;">

        <div style="background: white; padding: 40px; border: 1px solid #eee; box-shadow: 0 5px 20px rgba(0,0,0,0.05);">

            <div class="mb-4">
                <h2 style="font-weight: 800; letter-spacing: 5px; text-transform: uppercase;">
                    SUBMANCE
                </h2>
            </div>

            <h4 class="fw-bold mb-1">STAFF ACCESS</h4>
            <p class="text-muted small mb-4" style="letter-spacing: 1px;">AUTHORIZED PERSONNEL ONLY</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger rounded-0 small text-start p-2 mb-4">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Error
                </div>
            }

            <form asp-controller="Admin" asp-action="Login" method="post">

                <div class="text-start mb-3">
                    <label class="small fw-bold text-muted mb-1" style="font-size: 0.75rem;">EMAIL ADDRESS</label>
                    <input asp-for="Correo" type="email" class="form-control rounded-0"
                           style="padding: 10px; border-color: #ddd;"
                           placeholder="admin@submance.com" required />
                </div>

                <div class="text-start mb-4">
                    <label class="small fw-bold text-muted mb-1" style="font-size: 0.75rem;">PASSWORD</label>
                    <input asp-for="Password" type="password" class="form-control rounded-0"
                           style="padding: 10px; border-color: #ddd;"
                           placeholder="••••••••" required />
                </div>

                <button type="submit" class="btn btn-dark w-100 rounded-0 py-3 fw-bold" style="letter-spacing: 2px;">
                    ENTER STUDIO
                </button>

            </form>
        </div>

        <div class="mt-4">
            <a href="/" class="text-decoration-none text-muted fw-bold small" style="letter-spacing: 1px;">
                <i class="bi bi-arrow-left me-1"></i> BACK TO WEBSITE
            </a>
        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>