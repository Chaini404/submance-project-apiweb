<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso Submance</title>

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&family=Oswald:wght@500;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        /* (Tus estilos originales aquí - Sin cambios) */
        :root {
            --bg-dark: #050505;
            --accent: #00f3ff;
            --text-main: #ffffff;
            --error: #ff3333;
            --success: #00ff00;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background-image: radial-gradient(circle at 50% 50%, #1a1a1a 0%, #000000 70%);
        }

        .login-container {
            width: 100%;
            max-width: 420px;
            padding: 20px;
            position: relative;
            z-index: 10;
        }

        .login-card {
            background: rgba(17, 17, 17, 0.95);
            border: 1px solid #333;
            padding: 50px 40px;
            backdrop-filter: blur(10px);
            box-shadow: 0 0 40px rgba(0,0,0,0.8);
            position: relative;
        }

            .login-card::before {
                content: '';
                position: absolute;
                top: -1px;
                left: -1px;
                width: 20px;
                height: 20px;
                border-top: 2px solid var(--accent);
                border-left: 2px solid var(--accent);
            }

            .login-card::after {
                content: '';
                position: absolute;
                bottom: -1px;
                right: -1px;
                width: 20px;
                height: 20px;
                border-bottom: 2px solid var(--accent);
                border-right: 2px solid var(--accent);
            }

        .brand-title {
            font-family: 'Oswald', sans-serif;
            font-size: 2.5rem;
            font-weight: 700;
            letter-spacing: 4px;
            text-align: center;
            margin-bottom: 5px;
            color: var(--text-main);
            text-transform: uppercase;
        }

        .system-badge {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--accent);
            text-align: center;
            margin-bottom: 40px;
            display: block;
            opacity: 0.8;
        }

        .form-group {
            position: relative;
            margin-bottom: 30px;
        }

        .custom-input {
            width: 100%;
            background: transparent;
            border: none;
            border-bottom: 1px solid #333;
            padding: 10px 0;
            color: white;
            font-family: 'Montserrat', sans-serif;
            font-size: 1rem;
            transition: all 0.3s ease;
            border-radius: 0;
        }

            .custom-input:focus {
                outline: none;
                border-bottom-color: var(--accent);
                padding-left: 10px;
                background: linear-gradient(90deg, rgba(0,243,255,0.05) 0%, transparent 100%);
            }

        .input-icon {
            position: absolute;
            right: 0;
            top: 10px;
            color: #444;
            transition: 0.3s;
        }

        .custom-input:focus ~ .input-icon {
            color: var(--accent);
        }

        .btn-access {
            background: white;
            color: black;
            border: none;
            width: 100%;
            padding: 15px;
            font-family: 'Oswald', sans-serif;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-size: 1.1rem;
            cursor: pointer;
            transition: 0.3s;
            margin-top: 10px;
        }

            .btn-access:hover {
                background: var(--accent);
                color: black;
                box-shadow: 0 0 20px rgba(0,243,255,0.4);
            }

            .btn-access:disabled {
                background: #333;
                color: #666;
                cursor: wait;
            }

        .btn-link-action {
            background: none;
            border: none;
            color: var(--accent);
            font-family: 'Montserrat', sans-serif;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            text-decoration: underline;
            margin-top: 15px;
            width: 100%;
            text-align: center;
        }

        .back-link {
            text-align: center;
            margin-top: 30px;
        }

            .back-link a {
                color: #444;
                text-decoration: none;
                text-transform: uppercase;
                letter-spacing: 2px;
                font-size: 0.75rem;
                transition: 0.3s;
            }

                .back-link a:hover {
                    color: var(--accent);
                }

        .alert-system {
            font-size: 0.8rem;
            padding: 10px 15px;
            margin-bottom: 25px;
            align-items: center;
        }

        .alert-error {
            background: rgba(255, 51, 51, 0.1);
            border-left: 3px solid var(--error);
            color: #ff8888;
        }

        .alert-success {
            background: rgba(0, 255, 0, 0.1);
            border-left: 3px solid var(--success);
            color: #88ff88;
        }

        .hidden {
            display: none;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="login-card">
            <div class="brand-title">SUBMANCE</div>
            <span class="system-badge" id="formSubtitle">Secure Access Terminal // v2.4</span>

            @if (ViewBag.Error != null)
            {
                <div class="alert-system alert-error d-flex">
                    <i class="bi bi-shield-x me-2"></i> <span>@ViewBag.Error</span>
                </div>
            }
            @if (ViewBag.Success != null)
            {
                <div class="alert-system alert-success d-flex">
                    <i class="bi bi-shield-check me-2"></i> <span>@ViewBag.Success</span>
                </div>
            }

            <form asp-controller="Admin" asp-action="Login" method="post" id="loginForm">
                <div class="form-group">
                    <input type="email" class="custom-input" id="emailLogin" name="Correo" placeholder="Operator Email" required autocomplete="email">
                    <i class="bi bi-person-fill input-icon"></i>
                </div>

                <div class="form-group">
                    <input type="password" class="custom-input" id="passwordLogin" name="Password" placeholder="Access Code" required>
                    <i class="bi bi-lock-fill input-icon"></i>
                </div>

                <button type="submit" class="btn-access" id="btnSubmitLogin">
                    <span id="btnTextLogin">Initialize Session</span>
                </button>
            </form>

            <form asp-controller="Admin" asp-action="Registro" method="post" id="registerForm" class="hidden">
                <div class="form-group mb-4">
                    <input type="email" class="custom-input" name="Correo" placeholder="Email" required>
                    <i class="bi bi-envelope-fill input-icon"></i>
                </div>
                <div class="form-group mb-4">
                    <input type="password" class="custom-input" name="Password" placeholder="Password (Min 6 chars)" required minlength="6">
                    <i class="bi bi-key-fill input-icon"></i>
                </div>
                <div class="form-group mb-4">
                    <input type="text" class="custom-input" name="NombreArtistico" placeholder="Artist Name (DJ Alias)" required>
                    <i class="bi bi-mic-fill input-icon"></i>
                </div>
                <div class="form-group mb-4">
                    <input type="text" class="custom-input" name="NombreReal" placeholder="Real Name" required>
                    <i class="bi bi-person-badge-fill input-icon"></i>
                </div>
                <div class="form-group mb-4">
                    <input type="text" class="custom-input" name="Pais" placeholder="Country" required>
                    <i class="bi bi-globe-americas input-icon"></i>
                </div>

                <button type="submit" class="btn-access" id="btnSubmitRegister">
                    <span id="btnTextRegister">Create DJ Account</span>
                </button>
            </form>

            <button type="button" class="btn-link-action" id="toggleFormBtn" onclick="toggleForms()">
                New DJ? Request Access
            </button>
        </div>

        <div class="back-link">
            <a href="/">
                <i class="bi bi-arrow-return-left me-1"></i> Return to Public Site
            </a>
        </div>
    </div>

    <script>
        // Animación de Submit
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            animateSubmit(e, 'btnSubmitLogin', 'btnTextLogin', 'AUTHENTICATING...');
        });

        document.getElementById('registerForm').addEventListener('submit', function(e) {
            animateSubmit(e, 'btnSubmitRegister', 'btnTextRegister', 'PROVISIONING...');
        });

        function animateSubmit(e, btnId, txtId, msg) {
            e.preventDefault();
            const btn = document.getElementById(btnId);
            const btnText = document.getElementById(txtId);
            btn.disabled = true;
            btnText.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> ${msg}`;
            btn.style.backgroundColor = '#333';
            btn.style.color = '#fff';
            setTimeout(() => { e.target.submit(); }, 800);
        }

        // Cambio de vista entre Login y Registro
        function toggleForms() {
            const loginForm = document.getElementById('loginForm');
            const registerForm = document.getElementById('registerForm');
            const toggleBtn = document.getElementById('toggleFormBtn');
            const subtitle = document.getElementById('formSubtitle');

            if (loginForm.classList.contains('hidden')) {
                // Muestra Login
                loginForm.classList.remove('hidden');
                registerForm.classList.add('hidden');
                toggleBtn.innerText = 'New DJ? Request Access';
                subtitle.innerText = 'Secure Access Terminal // v2.4';
            } else {
                // Muestra Registro
                loginForm.classList.add('hidden');
                registerForm.classList.remove('hidden');
                toggleBtn.innerText = 'Already have access? Login here';
                subtitle.innerText = 'Artist Onboarding System';
            }
        }
    </script>
</body>
</html>