@{
    Layout = null;
    ViewData["Title"] = "Submance Dashboard";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - Submance Records</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
</head>
<body>

    <aside class="sidebar">
        <a href="javascript:void(0)" class="sidebar-brand"><i class="bi bi-vinyl-fill"></i> SUBMANCE</a>

        <nav class="flex-grow-1">
            <a onclick="nav('home')" class="nav-item active" id="link-home"><i class="bi bi-grid-fill"></i> Overview</a>
            <a onclick="nav('inbox')" class="nav-item" id="link-inbox"><i class="bi bi-inbox-fill"></i> Buzón <span class="badge bg-danger ms-2" id="badge-inbox">0</span></a>
            <a onclick="nav('demos')" class="nav-item" id="link-demos"><i class="bi bi-music-note-list"></i> Demos</a>
            <a onclick="nav('artists')" class="nav-item" id="link-artists"><i class="bi bi-people-fill"></i> Artistas</a>
            <a onclick="nav('releases')" class="nav-item" id="link-releases"><i class="bi bi-rocket-takeoff-fill"></i> Lanzamientos</a>
            <a onclick="nav('reports')" class="nav-item" id="link-reports"><i class="bi bi-file-text-fill"></i> Reportes</a>
        </nav>

        <div class="mt-auto pt-3 border-top">
            <button onclick="toggleDarkMode()" class="btn btn-outline-secondary w-100 btn-sm fw-bold border-0 text-start ps-0 mb-2">
                <i id="theme-icon" class="bi bi-moon-fill me-2 ms-2"></i> Tema
            </button>

            <button onclick="logoutConfirm()" class="btn btn-outline-danger w-100 btn-sm fw-bold border-0 text-start ps-0">
                <i class="bi bi-box-arrow-left me-2 ms-2"></i> Cerrar Sesión
            </button>
        </div>
    </aside>

    <main class="main-content">

        <section id="view-home" class="view-section animate__animated animate__fadeIn">
            <h2 class="page-title">Dashboard Overview</h2>
            <div class="row g-4 mb-4">
                <div class="col-md-3"><div class="stat-card border-left-purple"><div class="stat-label">Total Demos</div><div class="stat-value" id="st-total">0</div></div></div>
                <div class="col-md-3"><div class="stat-card border-left-pink"><div class="stat-label">Pendientes</div><div class="stat-value" id="st-pend">0</div></div></div>
                <div class="col-md-3"><div class="stat-card border-left-cyan"><div class="stat-label">Aprobados</div><div class="stat-value" id="st-aprob">0</div></div></div>
                <div class="col-md-3"><div class="stat-card"><div class="stat-label">Artistas</div><div class="stat-value" id="st-arts">0</div></div></div>
            </div>
            <div class="stat-card p-4" style="height: 450px;"><h5 class="fw-bold mb-3">Distribución</h5><div style="position: relative; height: 100%;"><canvas id="chartOverview"></canvas></div></div>
        </section>

        <section id="view-inbox" class="view-section hidden animate__animated animate__fadeIn">
            <h2 class="page-title">Buzón de Entrada</h2>
            <div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Track / Info</th><th>Artista</th><th>Escuchar</th><th>Acciones</th></tr></thead><tbody id="inboxTableBody"></tbody></table></div></div>
        </section>
        <section id="view-demos" class="view-section hidden animate__animated animate__fadeIn">
            <div class="d-flex justify-content-between mb-4"><div><h2 class="page-title mb-1">Catálogo</h2></div><div class="d-flex gap-2"><select class="form-select form-select-sm" onchange="setFilterStatus(this.value)"><option value="Todos">Todos</option><option value="Pendiente">Pendientes</option><option value="Aprobada">Aprobados</option></select><input class="form-control form-control-sm" placeholder="Buscar..." onkeyup="setFilterText(this.value)"><button class="btn btn-dark btn-sm rounded-circle" onclick="openAddDemoModal()"><i class="bi bi-plus-lg"></i></button></div></div><div class="row g-4" id="demosGrid"></div>
        </section>
        <section id="view-artists" class="view-section hidden animate__animated animate__fadeIn">
            <div class="d-flex justify-content-between mb-4"><div><h2 class="page-title mb-1">Roster</h2></div><div class="d-flex gap-2"><input class="form-control form-control-sm" placeholder="Buscar..." onkeyup="setArtistFilterText(this.value)"><button class="btn btn-dark btn-sm rounded-circle" onclick="openAddArtistModal()"><i class="bi bi-plus-lg"></i></button></div></div><div class="row g-4" id="artistsGrid"></div>
        </section>
        <section id="view-releases" class="view-section hidden animate__animated animate__fadeIn">
            <div class="d-flex justify-content-between mb-4"><h2 class="page-title">Calendario</h2></div><div class="row g-4" id="releasesGrid"></div>
        </section>

        <section id="view-reports" class="view-section hidden animate__animated animate__fadeIn">
            <h2 class="page-title mb-4">Centro de Reportes</h2>

            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-purple-soft">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                    <div>
                        <h4 class="fw-bold text-dark mb-1"><i class="bi bi-file-earmark-pdf-fill me-2 text-purple"></i>Generador Maestro</h4>
                        <p class="text-muted small mb-0">Descarga un reporte completo de toda la base de datos.</p>
                    </div>
                    <button class="btn btn-purple px-4 py-2 fw-bold shadow-sm" onclick="generarReportePDF('todos')">
                        <i class="bi bi-download me-2"></i>Descargar Todo
                    </button>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4 hover-card">
                        <div class="mb-3 text-warning"><i class="bi bi-hourglass-split fs-2"></i></div>
                        <h5 class="fw-bold">Pendientes de Revisión</h5>
                        <p class="text-muted small">Lista de demos que aún requieren feedback del equipo A&R.</p>
                        <button class="btn btn-outline-warning w-100 mt-auto" onclick="generarReportePDF('pendientes')">Generar PDF</button>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4 hover-card">
                        <div class="mb-3 text-success"><i class="bi bi-rocket-takeoff-fill fs-2"></i></div>
                        <h5 class="fw-bold">Plan de Lanzamientos</h5>
                        <p class="text-muted small">Cronograma de tracks aprobados y sus fechas de salida.</p>
                        <button class="btn btn-outline-success w-100 mt-auto" onclick="generarReportePDF('lanzamientos')">Generar PDF</button>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4 hover-card">
                        <div class="mb-3 text-primary"><i class="bi bi-people-fill fs-2"></i></div>
                        <h5 class="fw-bold">Directorio de Artistas</h5>
                        <p class="text-muted small">Base de datos de contactos y correos de todo el roster.</p>
                        <button class="btn btn-outline-primary w-100 mt-auto" onclick="generarReportePDF('artistas')">Generar PDF</button>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
</body>
</html>