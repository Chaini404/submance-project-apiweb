@{
    Layout = null;
    ViewData["Title"] = "Submance Dashboard";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - Submance Records</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>

    <aside class="sidebar">
        <a href="javascript:void(0)" class="sidebar-brand"><i class="bi bi-vinyl-fill"></i> SUBMANCE</a>

        <nav class="flex-grow-1">
            <a onclick="nav('home')" class="nav-item active" id="link-home"><i class="bi bi-grid-fill"></i> Overview</a>
            <a onclick="nav('inbox')" class="nav-item" id="link-inbox"><i class="bi bi-inbox-fill"></i> Buzón <span class="badge bg-danger ms-2" id="badge-inbox">0</span></a>
            <a onclick="nav('demos')" class="nav-item" id="link-demos"><i class="bi bi-music-note-list"></i> Demos</a>
            <a onclick="nav('artists')" class="nav-item" id="link-artists"><i class="bi bi-people-fill"></i> Artistas</a>
            <a onclick="nav('releases')" class="nav-item" id="link-releases"><i class="bi bi-rocket-takeoff-fill"></i> Lanzamientos</a>
            <a onclick="nav('reports')" class="nav-item" id="link-reports"><i class="bi bi-file-text-fill"></i> Reportes</a>
        </nav>

        <div class="mt-auto pt-3 border-top">
            <button onclick="toggleDarkMode()" class="btn btn-outline-secondary w-100 btn-sm fw-bold border-0 text-start ps-0 mb-2">
                <i id="theme-icon" class="bi bi-moon-fill me-2 ms-2"></i> Tema
            </button>

            <button onclick="logoutConfirm()" class="btn btn-outline-danger w-100 btn-sm fw-bold border-0 text-start ps-0">
                <i class="bi bi-box-arrow-left me-2 ms-2"></i> Cerrar Sesión
            </button>
        </div>
    </aside>

    <main class="main-content">

        <section id="view-home" class="view-section animate__animated animate__fadeIn">
            <h2 class="page-title">Dashboard Overview</h2>
            <div class="row g-4 mb-4">
                <div class="col-md-3"><div class="stat-card border-left-purple"><div class="stat-label">Total Demos</div><div class="stat-value" id="st-total">0</div></div></div>
                <div class="col-md-3"><div class="stat-card border-left-pink"><div class="stat-label">Pendientes</div><div class="stat-value" id="st-pend">0</div></div></div>
                <div class="col-md-3"><div class="stat-card border-left-cyan"><div class="stat-label">Aprobados</div><div class="stat-value" id="st-aprob">0</div></div></div>
                <div class="col-md-3"><div class="stat-card"><div class="stat-label">Artistas</div><div class="stat-value" id="st-arts">0</div></div></div>
            </div>

            <div class="stat-card p-4" style="height: 450px; display: flex; flex-direction: column;">
                <h5 class="fw-bold mb-3">Distribución por Estado</h5>
                <div style="position: relative; flex-grow: 1; min-height: 0; width: 100%;">
                    <canvas id="chartOverview"></canvas>
                </div>
            </div>
        </section>

        <section id="view-inbox" class="view-section hidden animate__animated animate__fadeIn">
            <h2 class="page-title">Buzón de Entrada</h2>
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Track / Info</th>
                                <th>Artista</th>
                                <th>Escuchar</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="inboxTableBody"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <section id="view-demos" class="view-section hidden animate__animated animate__fadeIn">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-end align-items-md-center mb-4 gap-3">
                <div>
                    <h2 class="page-title mb-1">Catálogo</h2>
                    <p class="text-muted small mb-0">Gestión de demos.</p>
                </div>
                <div class="d-flex align-items-center gap-2 bg-white p-1 rounded-pill shadow-sm border">
                    <select class="form-select form-select-sm border-0 bg-transparent fw-bold text-muted ps-3" style="width: auto; cursor: pointer;" onchange="setFilterStatus(this.value)">
                        <option value="Todos">Todos</option>
                        <option value="Pendiente">Pendientes</option>
                        <option value="Aprobada">Aprobados</option>
                        <option value="Rechazada">Rechazados</option>
                    </select>
                    <div class="vr text-muted opacity-25"></div>
                    <div class="input-group input-group-sm border-0" style="width: 150px;">
                        <span class="input-group-text bg-transparent border-0 pe-1"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control bg-transparent border-0 ps-1" placeholder="Buscar..." onkeyup="setFilterText(this.value)">
                    </div>
                    <button class="btn btn-dark btn-sm rounded-circle d-flex align-items-center justify-content-center me-1" style="width: 32px; height: 32px;" onclick="openAddDemoModal()" title="Nuevo Demo">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
            </div>
            <div class="row g-4" id="demosGrid"></div>
        </section>

        <section id="view-artists" class="view-section hidden animate__animated animate__fadeIn">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-end align-items-md-center mb-4 gap-3">
                <div>
                    <h2 class="page-title mb-1">Roster de Artistas</h2>
                    <p class="text-muted small mb-0">Directorio y gestión de talentos.</p>
                </div>
                <div class="d-flex align-items-center gap-2 bg-white p-1 rounded-pill shadow-sm border">
                    <select class="form-select form-select-sm border-0 bg-transparent fw-bold text-muted ps-3" style="width: auto; cursor: pointer;" onchange="setArtistSort(this.value)">
                        <option value="az">A - Z</option>
                        <option value="za">Z - A</option>
                        <option value="tracks">Más Tracks</option>
                    </select>
                    <div class="vr text-muted opacity-25"></div>
                    <div class="input-group input-group-sm border-0" style="width: 180px;">
                        <span class="input-group-text bg-transparent border-0 pe-1"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control bg-transparent border-0 ps-1" placeholder="Buscar artista..." onkeyup="setArtistFilterText(this.value)">
                    </div>
                    <button class="btn btn-dark btn-sm rounded-circle d-flex align-items-center justify-content-center me-1" style="width: 32px; height: 32px;" onclick="openAddArtistModal()" title="Añadir Artista">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
            </div>
            <div class="row g-4" id="artistsGrid"></div>
        </section>

        <section id="view-releases" class="view-section hidden animate__animated animate__fadeIn">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="page-title mb-1">Calendario de Lanzamientos</h2>
                    <p class="text-muted small mb-0">Tracks aprobados y planificación.</p>
                </div>
                <button class="btn btn-sm btn-outline-dark fw-bold shadow-sm" onclick="window.print()">
                    <i class="bi bi-printer-fill me-2"></i>Imprimir Plan
                </button>
            </div>
            <div class="row g-4" id="releasesGrid">
            </div>
        </section>

        <section id="view-reports" class="view-section hidden animate__animated animate__fadeIn">
            <h2 class="page-title">Reportes Guía</h2>
            <div class="p-4 bg-dark text-white rounded shadow-sm d-flex justify-content-between align-items-center">
                <div><h4>Generador PDF</h4><small>Descarga listados oficiales</small></div>
                <button class="btn btn-light fw-bold" onclick="Swal.fire('PDF','Función lista para conectar','info')">Descargar</button>
            </div>
        </section>

    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
</body>
</html>