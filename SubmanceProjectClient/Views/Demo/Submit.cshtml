@model Submance.Application.DTOs.Demo.DemoDto

@{
    ViewData["Title"] = "Enviar Demo";
    // Layout = null; // O usa tu layout público por defecto
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center mb-5">
            <h1 class="display-4 fw-bold">SUBMANCE</h1>
            <p class="lead text-muted">UPLOAD YOUR DEMO</p>
        </div>

        <div class="col-md-6">
            @if (ViewBag.Message != null)
            {
                <div class="alert alert-success text-center">@ViewBag.Message</div>
            }

            <form asp-action="Submit" method="post" class="p-4 shadow-sm bg-white border rounded">
                <div class="mb-3">
                    <label class="form-label text-uppercase small fw-bold">Artist Name</label>
                    <input asp-for="NombreArtistico" class="form-control" placeholder="Your Stage Name" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-uppercase small fw-bold">Track Title</label>
                    <input asp-for="NombreTrack" class="form-control" placeholder="Original Mix" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-uppercase small fw-bold">Email</label>
                    <input asp-for="Email" type="email" class="form-control" required />
                </div>

                <div class="mb-4">
                    <label class="form-label text-uppercase small fw-bold">Private Link (Soundcloud/Dropbox)</label>
                    <input asp-for="LinkAudio" class="form-control" placeholder="https://..." required />
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-dark btn-lg">SEND DEMO</button>
                </div>
            </form>

            <div class="text-center mt-4">
                <a asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none">← Back to Home</a>
            </div>
        </div>
    </div>
</div>