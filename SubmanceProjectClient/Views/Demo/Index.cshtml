<!-- Demo/Index.cshtml -->
@model IEnumerable<Submance.Domain.Entities.Cancion>

@{
    ViewData["Title"] = "Mis Demos";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Estilos Locales - Portal Artistas -->
<style>
    /* Header & Layout */
    .admin-header {
        border-bottom: 1px solid #333;
        padding-bottom: 20px;
        margin-bottom: 30px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    .page-title {
        font-family: 'Oswald', sans-serif;
        text-transform: uppercase;
        font-size: 2.5rem;
        color: white;
        margin: 0;
        line-height: 1;
    }

    .page-subtitle {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 4px;
        color: #00f3ff;
        display: block;
        margin-bottom: 5px;
    }

    .header-desc {
        color: #666;
        font-size: 0.85rem;
        margin-top: 5px;
        max-width: 500px;
    }

    /* Botones */
    .btn-industrial {
        background: white;
        color: black;
        border: none;
        padding: 10px 25px;
        font-family: 'Oswald', sans-serif;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-decoration: none;
        transition: 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-industrial:hover {
            background: #00f3ff;
            color: black;
            box-shadow: 0 0 15px rgba(0, 243, 255, 0.4);
        }

    .btn-play-industrial {
        border: 1px solid #333;
        background: transparent;
        color: white;
        border-radius: 50px;
        padding: 4px 15px;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-decoration: none;
        transition: 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .btn-play-industrial:hover {
            border-color: #00f3ff;
            color: #00f3ff;
            background: rgba(0, 243, 255, 0.05);
        }

    /* Tabla Industrial */
    .industrial-table {
        width: 100%;
        border-collapse: collapse;
    }

        .industrial-table thead th {
            text-align: left;
            padding: 15px 20px;
            color: #666;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            border-bottom: 1px solid #333;
            font-weight: 600;
        }

        .industrial-table tbody tr {
            border-bottom: 1px solid #1a1a1a;
            transition: 0.2s;
        }

            .industrial-table tbody tr:hover {
                background: rgba(255, 255, 255, 0.03);
            }

        .industrial-table td {
            padding: 20px;
            color: white;
            vertical-align: middle;
        }

    .track-title {
        font-family: 'Oswald', sans-serif;
        font-size: 1.1rem;
        letter-spacing: 1px;
        color: white;
        display: block;
    }

    .track-mix {
        color: #888;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* Estados */
    .status-dot {
        height: 6px;
        width: 6px;
        display: inline-block;
        border-radius: 50%;
        margin-right: 8px;
        vertical-align: middle;
    }

    .st-pending {
        background-color: #ffcc00;
        box-shadow: 0 0 5px #ffcc00;
    }

    .st-approved {
        background-color: #00ff88;
        box-shadow: 0 0 5px #00ff88;
    }

    .st-rejected {
        background-color: #ff3333;
        opacity: 0.7;
    }

    .status-text {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #ccc;
    }

    .genre-tag {
        border: 1px solid #333;
        padding: 2px 8px;
        font-size: 0.7rem;
        text-transform: uppercase;
        color: #888;
    }

    /* Estado Vacío */
    .empty-state-row td {
        text-align: center;
        padding: 80px 20px;
        color: #444;
    }

    .empty-state-icon {
        font-size: 3rem;
        margin-bottom: 15px;
        display: block;
        opacity: 0.3;
        color: #00f3ff;
    }
</style>

<div class="container-fluid pt-4">

    <!-- Header -->
    <div class="admin-header">
        <div>
            <span class="page-subtitle">Artist Portal</span>
            <h2 class="page-title">Mis Demos</h2>
            <div class="header-desc">Visualiza el estado de tus tracks enviados al equipo de A&R.</div>
        </div>
        <a asp-controller="Demo" asp-action="Create" class="btn-industrial">
            <i class="bi bi-cloud-upload"></i> Subir Nuevo Demo
        </a>
    </div>

    <!-- Data Grid -->
    <div class="table-responsive">
        <table class="industrial-table">
            <thead>
                <tr>
                    <th>Track / Info</th>
                    <th>Género</th>
                    <th>Audio</th>
                    <th>Estado A&R</th>
                    <th>Fecha Envío</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="track-title">@item.Titulo</span>
                                <span class="track-mix">Original Mix</span>
                            </td>
                            <td>
                                <span class="genre-tag">
                                    @if (item.IdGenero == 1)
                                    {
                                        <text>TRANCE</text>
                                    }
                                    else if (item.IdGenero == 2)
                                    {

                                        <text>HOUSE</text>
                                    }
                                    else
                                    {

                                        <text>GENERAL</text>
                                    }
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.UrlAudio))
                                {
                                    <a href="@item.UrlAudio" target="_blank" class="btn-play-industrial">
                                        <i class="bi bi-play-fill"></i> PLAY
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small" style="letter-spacing:1px;">NO AUDIO</span>
                                }
                            </td>
                            <td>
                                @if (item.Estado == "Pendiente")
                                {
                                    <span class="status-dot st-pending"></span>
                                    <span class="status-text">Pendiente</span>
                                }
                                else if (item.Estado == "Aprobado")
                                {
                                    <span class="status-dot st-approved"></span>
                                    <span class="status-text text-white">Aprobado</span>
                                }
                                else if (item.Estado == "Rechazado")
                                {
                                    <span class="status-dot st-rejected"></span>
                                    <span class="status-text">Rechazado</span>
                                }
                                else
                                {
                                    <span class="status-text">@item.Estado</span>
                                }
                            </td>
                            <td class="text-muted" style="font-size: 0.8rem; font-family: 'Montserrat';">
                                @DateTime.Now.ToString("dd/MM/yyyy")
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr class="empty-state-row">
                        <td colspan="5">
                            <i class="bi bi-soundwave empty-state-icon"></i>
                            <h5 style="font-family: 'Oswald'; letter-spacing: 2px; color:white;">SIN REGISTROS</h5>
                            <div class="small mt-2">No has enviado ningún demo todavía.</div>
                            <a asp-controller="Demo" asp-action="Create" class="btn-industrial mt-4" style="background:transparent; color:white; border:1px solid white;">
                                Enviar Primer Track
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>