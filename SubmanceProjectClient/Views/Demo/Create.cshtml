@model Submance.Domain.Entities.Cancion

@{
    ViewData["Title"] = "Upload Demo";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mt-4" style="max-width: 800px;">
    <div class="card border-0 shadow-lg" style="background-color: #1e1e1e;">
        <div class="card-body p-5">

            <div class="text-center mb-5">
                <i class="bi bi-cloud-upload text-primary" style="font-size: 3rem;"></i>
                <h2 class="fw-bold mt-3 text-white">Sube tu Demo</h2>
                <p class="text-muted">Asegúrate de que tu track esté en formato privado (SoundCloud/Dropbox).</p>
            </div>

            <form asp-action="Create" method="post">
                <div class="row g-4">

                    <div class="col-12">
                        <label class="form-label text-uppercase small fw-bold text-muted">Título del Track</label>
                        <input asp-for="Titulo" class="form-control form-control-lg bg-dark text-white border-secondary" placeholder="Ej: Midnight Summer (Original Mix)" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-uppercase small fw-bold text-muted">Género</label>
                        <select asp-for="IdGenero" class="form-select form-select-lg bg-dark text-white border-secondary">
                            <option value="1">Trance</option>
                            <option value="2">Techno</option>
                            <option value="3">Progressive House</option>
                            <option value="4">Deep House</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-uppercase small fw-bold text-muted">Link de Audio</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-link-45deg"></i></span>
                            <input asp-for="Archivo" type="url" class="form-control form-control-lg bg-dark text-white border-secondary" placeholder="https://soundcloud.com/..." required />
                        </div>
                        <div class="form-text text-muted">Solo enlaces directos o streaming.</div>
                    </div>

                    <div class="col-12 mt-5 d-flex gap-3">
                        <a asp-controller="ArtistPortal" asp-action="Index" class="btn btn-outline-light px-4">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-5 fw-bold flex-grow-1">
                            ENVIAR DEMO <i class="bi bi-send-fill ms-2"></i>
                        </button>
                    </div>

                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mt-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                    </div>
                }
            </form>
        </div>
    </div>
</div>