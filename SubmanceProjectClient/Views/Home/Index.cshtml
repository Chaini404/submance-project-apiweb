<!-- Home/Index.cshtml -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SUBMANCE | Uplifting Trance</title>

    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;800&family=Oswald:wght@500;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/home-index.css" />
</head>
<body>

    <!-- Header -->
    <header class="fixed-header" id="mainHeader">
        <a href="#home" class="brand-logo">SUBMANCE</a>
        <nav class="top-nav d-none d-md-flex align-items-center">
            <a href="#home">HOME</a>
            <a href="#releases">RELEASES</a>
            <a href="#contact">CONTACT</a>
            <a href="/Admin/Login" class="login-btn ms-4">LOGIN</a>
        </nav>
        <button class="btn text-white d-md-none"><i class="bi bi-list fs-2"></i></button>
    </header>

    <!-- Hero Section -->
    <section id="home" class="full-section">
        <h1 class="hero-title text-center">SUBMANCE</h1>
        <p class="hero-subtitle">Uplifting Trance Label</p>
        <i class="bi bi-arrow-down-circle fs-1 scroll-indicator mt-5" onclick="scrollToSection('releases')"></i>
    </section>

    <!-- Releases Section (Light Mode) -->
    <section id="releases" class="full-section">
        <h2 class="section-title">Latest Releases</h2>

        <div class="release-grid">
            <!-- Mockup 1 -->
            <div class="release-card">
                <div class="w-100 h-100 bg-dark d-flex align-items-center justify-content-center text-white-50">
                    <i class="bi bi-vinyl fs-1"></i>
                </div>
                <div class="release-overlay">
                    <h5 class="fw-bold mb-0">ETERNAL LIGHT</h5>
                    <small>LUMINA</small>
                </div>
            </div>
            <!-- Mockup 2 -->
            <div class="release-card">
                <div class="w-100 h-100 bg-secondary d-flex align-items-center justify-content-center text-white-50">
                    <i class="bi bi-soundwave fs-1"></i>
                </div>
                <div class="release-overlay">
                    <h5 class="fw-bold mb-0">DEEP STATE</h5>
                    <small>SYSTEM F</small>
                </div>
            </div>
            <!-- Mockup 3 -->
            <div class="release-card">
                <div class="w-100 h-100 bg-dark d-flex align-items-center justify-content-center text-white-50">
                    <i class="bi bi-music-note-beamed fs-1"></i>
                </div>
                <div class="release-overlay">
                    <h5 class="fw-bold mb-0">OXYGEN</h5>
                    <small>AIRWAVE</small>
                </div>
            </div>
            <!-- Mockup 4 -->
            <div class="release-card">
                <div class="w-100 h-100 bg-secondary d-flex align-items-center justify-content-center text-white-50">
                    <i class="bi bi-disc fs-1"></i>
                </div>
                <div class="release-overlay">
                    <h5 class="fw-bold mb-0">GRAVITY</h5>
                    <small>SOLAR</small>
                </div>
            </div>
        </div>

        <i class="bi bi-arrow-down-circle fs-1 mt-5 text-dark scroll-indicator" style="cursor:pointer;" onclick="scrollToSection('contact')"></i>
    </section>

    <!-- Contact Section (Monster Layout) -->
    <section id="contact" class="full-section" style="justify-content: center;">
        <div class="contact-monster-container">
            <div class="monster-col">
                <div class="monster-title">LIAISE</div>
                <div class="monster-text">General Info:<br><span>info@submance.com</span></div>
                <div class="monster-text mt-4">Demos:<br><span>demos@submance.com</span></div>
                <div class="monster-text mt-4">HQ Location:<br><span>San Isidro, Lima, Peru</span></div>
            </div>

            <div class="monster-col">
                <div class="monster-title">DEMOS</div>
                <p class="text-muted mb-4" style="font-size: 0.9rem; line-height: 1.6;">
                    We are looking for Uplifting & Progressive Trance with soul. <br>
                    Please allow up to 14 days for A&R review.
                </p>
                <button class="btn-monster-demo" data-bs-toggle="modal" data-bs-target="#demoModal">
                    <span>SUBMIT DEMO</span>
                </button>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="fixed-footer">
        <div id="copyright-text">&copy; 2026 SUBMANCE RECORDS</div>
        <div>
            <a href="#"><i class="bi bi-instagram me-4 fs-5"></i></a>
            <a href="#"><i class="bi bi-facebook me-4 fs-5"></i></a>
            <a href="#"><i class="bi bi-soundcloud fs-5"></i></a>
        </div>
    </footer>

    <!-- Demo Modal -->
    <div class="modal fade" id="demoModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold ps-2 pt-1 text-white">SUBMIT TRACK</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="one-forty-container">
                        <form id="demoFormTag">
                            <input type="text" id="inputArtistName" name="ArtistName" class="input-one-forty" placeholder="Artist Name" required>
                            <input type="text" id="inputTrackTitle" name="TrackTitle" class="input-one-forty" placeholder="Track Title" required>
                            <input type="email" id="inputEmail" name="Email" class="input-one-forty" placeholder="Email Address" required>

                            <select id="inputExclusive" name="Exclusive" class="input-one-forty">
                                <option value="" disabled selected>Is Your Track Exclusive?</option>
                                <option value="Yes">Yes</option>
                                <option value="No">No</option>
                            </select>

                            <input type="url" id="inputLink" name="DemoLink" class="input-one-forty" placeholder="Soundcloud Private Link" required>

                            <div class="input-one-forty d-flex align-items-center text-muted" style="border-bottom: 1px dashed #444; cursor: pointer;">
                                <i class="bi bi-cloud-upload me-2 text-white"></i> Upload MP3 (Optional)
                            </div>

                            <div class="form-check mt-4 mb-4">
                                <input class="form-check-input bg-dark border-secondary" type="checkbox" required id="checkPerm" name="ConfirmRights">
                                <label class="form-check-label small text-muted" for="checkPerm">I confirm I own 100% of the rights to this track.</label>
                            </div>

                            <button type="submit" id="btnSubmitDemo" class="btn-submit-track">
                                <i class="bi bi-send-fill me-2"></i> SEND TO A&R
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Custom JavaScript -->
    <script src="~/js/home-index.js"></script>
</body>
</html>
