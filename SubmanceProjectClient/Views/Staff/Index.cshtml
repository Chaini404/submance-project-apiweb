@model IEnumerable<Submance.Domain.Entities.Cancion>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>A&R Terminal // SUBMANCE</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Oswald:wght@500;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/dashboard-staff.css" asp-append-version="true" />
</head>
<body>

    <nav class="premium-navbar d-flex justify-content-between align-items-center px-4 py-3">
        <div class="brand-logo">SUBMANCE</div>
        <div class="d-flex align-items-center gap-4">
            <span class="nav-status">INCOMING (@Model.Count())</span>

            <button id="theme-toggle" class="btn-theme-toggle" title="Alternar Tema">
                <i class="bi bi-moon-stars-fill moon-icon"></i>
                <i class="bi bi-sun-fill sun-icon"></i>
            </button>

            <a href="@Url.Action("Logout", "Admin")" class="btn-premium-outline">SALIR</a>
        </div>
    </nav>

    <main class="container-fluid premium-container py-5 px-4 px-lg-5">
        <header class="mb-5">
            <h1 class="page-title">Panel de Revisión A&R</h1>
            <p class="subtitle">SUBMANCE RECORDS // AUDITION SYSTEM</p>
        </header>

        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="premium-stat-card">
                    <div class="stat-label">PENDIENTES</div>
                    <div class="stat-value">@Model.Count()</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="premium-stat-card">
                    <div class="stat-label">PROMEDIO BPM</div>
                    <div class="stat-value text-accent">138.0</div>
                </div>
            </div>
        </div>

        <div class="table-responsive premium-table-wrapper">
            <table class="table premium-table">
                <thead>
                    <tr>
                        <th class="ps-4">CANCIÓN / ARTISTA</th>
                        <th>GÉNERO</th>
                        <th class="text-center">PREVIEW</th>
                        <th class="text-end pe-4">ACCIÓN</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="track-row">
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="track-artwork">
                                        <i class="bi bi-music-note"></i>
                                    </div>
                                    <div>
                                        <div class="track-title">@item.Titulo.ToUpper()</div>
                                        <div class="track-uid">UID: @item.IdArtista</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge-genre">UPLIFTING TRANCE</span>
                            </td>
                            <td class="text-center">
                                <button class="btn-play-preview" onclick="playTrack('@item.UrlAudio', '@item.Titulo', @item.IdDemo)">
                                    <i class="bi bi-play-circle" id="play-btn-@item.IdDemo"></i>
                                </button>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <form asp-action="Decidir" method="post">
                                        <input type="hidden" name="idCancion" value="@item.IdDemo" />
                                        <input type="hidden" name="decision" value="Aprobado" />
                                        <button type="submit" class="btn-action btn-approve">APROBAR</button>
                                    </form>
                                    <form asp-action="Decidir" method="post">
                                        <input type="hidden" name="idCancion" value="@item.IdDemo" />
                                        <input type="hidden" name="decision" value="Rechazado" />
                                        <button type="submit" class="btn-action btn-reject">RECHAZAR</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>

    <div id="global-player" class="premium-player d-none">
        <div class="player-inner">
            <div class="player-info">
                <div class="player-disc"><i class="bi bi-vinyl-fill"></i></div>
                <div class="player-meta">
                    <div id="player-title" class="player-title">--</div>
                    <div class="player-subtitle">A&R Audition</div>
                </div>
            </div>

            <div class="player-controls">
                <button class="btn-control-play" onclick="togglePlay()">
                    <i class="bi bi-play-fill" id="play-icon-main"></i>
                </button>
                <input type="range" class="premium-range" id="player-seek" value="0" step="0.1">
            </div>

            <div class="player-actions">
                <button class="btn-close-player" onclick="closePlayer()">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>
        <audio id="audio-source"></audio>
    </div>

    <script src="~/js/dashboard-staff.js" asp-append-version="true"></script>
</body>
</html>