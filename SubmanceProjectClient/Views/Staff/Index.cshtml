@model IEnumerable<Submance.Domain.Entities.Cancion>

@{
    ViewData["Title"] = "A&R Dashboard";
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-uppercase fw-bold ls-2">A&R Dashboard</h2>
            <p class="text-muted small">Revisión de Demos Pendientes</p>
        </div>
        <span class="badge bg-primary fs-6">Pendientes: @Model.Count()</span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-success text-center shadow-sm border-0 p-5">
            <h4 class="alert-heading">¡Todo limpio!</h4>
            <p>No hay demos pendientes de revisión en este momento.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-dark text-white text-uppercase small">
                        <tr>
                            <th class="ps-4">Track</th>
                            <th>Género</th>
                            <th>Link Audio</th>
                            <th>Estado Actual</th>
                            <th class="text-end pe-4">Decisión</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@item.Titulo</div>
                                    <div class="text-muted small">ID Artista: @item.IdArtista</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @item.IdGenero
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Archivo))
                                    {
                                        <a href="@item.Archivo" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill">
                                            ▶ Escuchar
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-warning text-dark">@item.Estado</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <form asp-action="Decidir" method="post">
                                            <input type="hidden" name="idCancion" value="@item.IdCancion" />
                                            <input type="hidden" name="decision" value="Aprobado" />
                                            <button type="submit" class="btn btn-sm btn-success" title="Aprobar Lanzamiento">
                                                ✓ Aprobar
                                            </button>
                                        </form>

                                        <form asp-action="Decidir" method="post">
                                            <input type="hidden" name="idCancion" value="@item.IdCancion" />
                                            <input type="hidden" name="decision" value="Rechazado" />
                                            <button type="submit" class="btn btn-sm btn-danger" title="Rechazar Demo">
                                                ✕ Rechazar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>