<!-- Artista/Index.cshtml -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Artist Index | SUBMANCE</title>

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&family=Oswald:wght@500;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/artista.css" />
</head>
<body>

    <div class="container-fluid">
        <div class="admin-header">
            <div>
                <span class="page-subtitle">Base de Datos</span>
                <h2 class="page-title">Directorio de Artistas</h2>
            </div>
            <a asp-action="Create" class="btn-industrial">
                <i class="bi bi-plus-lg"></i> Nuevo Registro
            </a>
        </div>

        <table class="industrial-table">
            <thead>
                <tr>
                    <th>Artista / ID</th>
                    <th>Contacto</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <div class="artist-name">SOLARSTONE</div>
                        <div class="meta-text">ID: ART-001</div>
                    </td>
                    <td class="meta-text">richard@puretrance.com</td>
                    <td>
                        <span class="status-dot status-active"></span>
                        <span class="status-text text-white">Activo</span>
                    </td>
                    <td class="text-end">
                        <a href="#" class="action-link"><i class="bi bi-pencil-square"></i></a>
                    </td>
                </tr>
                <tr>
                    <td>
                        <div class="artist-name">GIUSEPPE OTTAVIANI</div>
                        <div class="meta-text">ID: ART-002</div>
                    </td>
                    <td class="meta-text">booking@go-music.com</td>
                    <td>
                        <span class="status-dot status-active"></span>
                        <span class="status-text text-white">Activo</span>
                    </td>
                    <td class="text-end">
                        <a href="#" class="action-link"><i class="bi bi-pencil-square"></i></a>
                    </td>
                </tr>
                <tr>
                    <td>
                        <div class="artist-name text-muted">UNKNOWN PROJECT</div>
                        <div class="meta-text">ID: ART-009</div>
                    </td>
                    <td class="meta-text">No Contact</td>
                    <td>
                        <span class="status-dot status-inactive"></span>
                        <span class="status-text text-muted">Inactivo</span>
                    </td>
                    <td class="text-end">
                        <a href="#" class="action-link"><i class="bi bi-pencil-square"></i></a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

</body>
</html>