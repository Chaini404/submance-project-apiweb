<!-- Artista/Create.cshtml -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Artist | SUBMANCE</title>

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&family=Oswald:wght@500;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/artista.css" />
</head>
<body>

    <div class="admin-container">
        <h2 class="page-title">Nuevo Artista</h2>
        <span class="page-subtitle">Base de Datos de Talento // Registro</span>

        <form asp-action="Create" method="post">
            <div class="form-group">
                <label class="industrial-label">Nombre Artístico</label>
                <input type="text" name="NombreArtistico" class="industrial-input" placeholder="Ej. KEARNEY" required />
            </div>

            <div class="form-group">
                <label class="industrial-label">Nombre Real</label>
                <input type="text" name="NombreReal" class="industrial-input" placeholder="Nombre legal completo" required />
            </div>

            <div class="form-group">
                <label class="industrial-label">Correo Electrónico</label>
                <input type="email" name="Correo" class="industrial-input" placeholder="contacto@artista.com" required />
            </div>

            <div class="d-flex gap-3 mt-5">
                <button type="submit" class="btn-action-primary">
                    <i class="bi bi-save2-fill me-2"></i> Registrar Artista
                </button>
                <a asp-action="Index" class="btn-action-secondary">Cancelar</a>
            </div>
        </form>
    </div>

</body>
</html>